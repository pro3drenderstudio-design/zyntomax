# Database (docker-compose maps Postgres to host port 5433)
DATABASE_URL="postgresql://zyntomax:zyntomax_dev@localhost:5433/zyntomax"

# Redis (docker-compose maps to host port 6380)
REDIS_URL="redis://localhost:6380"

# Auth
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Paystack (test keys from dashboard.paystack.com)
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# SMS (Termii)
TERMII_API_KEY=""
TERMII_SENDER_ID="Zyntomax"

# File storage (S3-compatible, e.g. Cloudflare R2) — optional in dev, falls back to local /uploads
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="zyntomax"
