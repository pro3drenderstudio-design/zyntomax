{
  "expo": {
    "name": "Zyntomax Admin",
    "slug": "zyntomax-admin",
    "owner": "mizark",
    "version": "0.1.0",
    "scheme": "zyntomax-admin",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.zyntomax.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.zyntomax.admin",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to pin vendor locations and stamp weigh-ins.",
        "NSCameraUsageDescription": "Used to photograph weigh-ins and factory scale readings."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to pin vendor locations and stamp weigh-ins."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zyntomax Admin uses your camera to photograph weigh-ins and factory scale readings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zyntomax Admin accesses your photos so you can attach images to records."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Zyntomax Admin uses Face ID / fingerprint to lock the app."
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "apiUrl": "https://www.zyntomax.com",
      "router": {},
      "eas": {
        "projectId": "7102c5a6-dd6a-4701-abc2-53b5636f2488"
      }
    }
  }
}
