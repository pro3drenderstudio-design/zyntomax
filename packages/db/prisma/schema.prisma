// Zyntomax Platform — canonical data model.
// Design rules:
//  - Every operational record carries siteId (multi-site from day one).
//  - Inventory and money are append-only ledgers; balances are computed, never stored.
//  - Corrections are reversing entries, not edits.
//  - Weigh events capture who/when/where/photo for evidence (manual scales).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Core ───────────────────────────────

enum SiteKind {
  FACTORY
  COLLECTION_HUB
}

model Site {
  id        String   @id @default(cuid())
  name      String
  kind      SiteKind @default(FACTORY)
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles          UserRole[]
  localities         Locality[]
  vendors            Vendor[]
  trips              Trip[]
  purchaseBatches    PurchaseBatch[]
  inventoryLocations InventoryLocation[]
  jobs               Job[]
  rateCards          RateCard[]
  payrollRuns        PayrollRun[]
  salesOrders        SalesOrder[]
  expenses           Expense[]
  budgets            Budget[]
  targets            Target[]
  settings           Setting[]
  dieselLogs         DieselLog[]
  cashAccounts       CashAccount[]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXITED
}

model User {
  id           String     @id @default(cuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String?
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  staffProfile StaffProfile?
  auditLogs    AuditLog[]
  notifications Notification[]
  locations    AgentLocation[]
}

enum RoleName {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  FACTORY_SUPERVISOR
  FINANCE_ADMIN
  PURCHASING_MANAGER
  HR_ADMIN
  SALES_ADMIN
  TEAM_LEAD
  COLLECTION_AGENT
  PRODUCTION_STAFF
  AUDITOR
}

model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName
  siteId String? // null = global grant

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id])

  @@unique([userId, role, siteId])
}

enum WageModel {
  COMMISSION // piece-rate on good output only (default)
  SALARY // fixed weekly salary only
  COMMISSION_PLUS_BASE // piece-rate + weekly base
}

model StaffProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  staffNo          String    @unique
  title            String? // job title printed on the ID card, e.g. "Sorting Operator"
  wageModel        WageModel @default(COMMISSION)
  baseSalaryWeekly Decimal?  @db.Decimal(14, 2)
  photoUrl         String?
  address          String?
  hireDate         DateTime?
  bankName         String?
  bankAccountNo    String? // encrypted at application level
  bankAccountName  String? // Paystack-verified name
  bvnEncrypted     String? // application-level encrypted; display last-4 only
  nextOfKinName    String?
  nextOfKinPhone   String?
  emergencyName    String?
  emergencyPhone   String?
  paystackRecipient String? // transfer recipient code
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  tripMemberships TripMember[]
  ledTrips        Trip[]           @relation("TripLead")
  jobAssignments  JobAssignment[]
  payrollItems    PayrollItem[]
  advances        SalaryAdvance[]
  issuances       Issuance[]
  staffLogs       StaffLog[]
  discrepancyCharges DiscrepancyCharge[]
}

// Live GPS breadcrumb for a field agent (posted periodically during trips).
model AgentLocation {
  id         String   @id @default(cuid())
  userId     String
  tripId     String?
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model Setting {
  id     String  @id @default(cuid())
  key    String
  value  Json
  siteId String? // null = global default; site row overrides

  site Site? @relation(fields: [siteId], references: [id])

  @@unique([key, siteId])
}

// One-time passcode for vendor phone login (vendors don't manage passwords).
model VendorOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "trip.approve", "vendor.create"
  entity     String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  vendorId  String?
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  createdAt DateTime            @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([userId, status])
}

// ──────────────────────── Vendors & Collection ────────────────────────

model Locality {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())

  site    Site     @relation(fields: [siteId], references: [id])
  vendors Vendor[]
  trips   Trip[]

  @@unique([siteId, name])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

model Vendor {
  id              String       @id @default(cuid())
  siteId          String
  localityId      String?
  vendorNo        String?      @unique
  name            String
  nickname        String?
  phone           String       @unique
  photoUrl        String?
  address         String?
  lat             Float?
  lng             Float?
  bankName        String?
  bankAccountNo   String? // encrypted at application level
  bankAccountName String? // Paystack-verified name
  bankVerified    Boolean      @default(false)
  bvnEncrypted    String?
  paystackRecipient String?
  pushToken       String? // Expo push token for notifications
  referralCode    String?      @unique
  referredByCode  String? // referral code of the vendor who invited them
  status          VendorStatus @default(ACTIVE)
  registeredById  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  site           Site            @relation(fields: [siteId], references: [id])
  locality       Locality?       @relation(fields: [localityId], references: [id])
  pickupRequests PickupRequest[]
  weighIns       CollectionWeighIn[]
  payouts        Payout[]
  withdrawals    Withdrawal[]
  rewardGrants   RewardGrant[]
  notifications  Notification[]

  @@index([siteId, localityId])
}

model RewardTier {
  id          String  @id @default(cuid())
  name        String
  thresholdKg Decimal @db.Decimal(10, 2)
  reward      String // e.g. "Foodstuff pack"
  active      Boolean @default(true)

  grants RewardGrant[]
}

model RewardGrant {
  id           String   @id @default(cuid())
  vendorId     String
  tierId       String
  fulfilledBy  String?
  fulfilledAt  DateTime?
  createdAt    DateTime @default(now())

  vendor Vendor     @relation(fields: [vendorId], references: [id])
  tier   RewardTier @relation(fields: [tierId], references: [id])
}

enum PickupSource {
  APP
  SMS
  AGENT
}

enum PickupStatus {
  PENDING
  SCHEDULED
  COLLECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
}

/**
 * Vendor-initiated cash-out from their wallet. Wallet balance is computed:
 * Σ(weigh-in amounts) − Σ(released trip payouts) − Σ(active withdrawals).
 * A withdrawal debits that balance; admin approves → Paystack transfer.
 */
model Withdrawal {
  id             String           @id @default(cuid())
  vendorId       String
  amount         Decimal          @db.Decimal(14, 2)
  status         WithdrawalStatus @default(PENDING)
  method         String           @default("TRANSFER")
  bankName       String?
  accountLast4   String?
  paystackRef    String?
  idempotencyKey String           @unique
  failureReason  String?
  note           String?
  requestedAt    DateTime         @default(now())
  processedById  String?
  processedAt    DateTime?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
  @@index([status])
}

model PickupRequest {
  id          String       @id @default(cuid())
  vendorId    String
  estWeightKg Decimal?     @db.Decimal(10, 2) // optional — vendors may not know the weight
  photoUrl    String? // photo proof of the recyclables
  note        String?
  lat         Float?
  lng         Float?
  source      PickupSource @default(AGENT)
  status      PickupStatus @default(PENDING)
  tripId      String?
  createdAt   DateTime     @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@index([status])
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  RETURNED
  RECONCILED
  APPROVED
  PAID
  CANCELLED
}

model Trip {
  id         String     @id @default(cuid())
  siteId     String
  localityId String?
  leadId     String
  vehicle    String?
  date       DateTime
  status     TripStatus @default(PLANNED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  site           Site                @relation(fields: [siteId], references: [id])
  locality       Locality?           @relation(fields: [localityId], references: [id])
  lead           StaffProfile        @relation("TripLead", fields: [leadId], references: [id])
  members        TripMember[]
  pickupRequests PickupRequest[]
  weighIns       CollectionWeighIn[]
  reconciliation TripReconciliation?
  payoutBatch    PayoutBatch?
  expenses       Expense[]

  @@index([siteId, date])
}

model TripMember {
  id      String @id @default(cuid())
  tripId  String
  staffId String

  trip  Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  staff StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([tripId, staffId])
}

enum ConfirmationMethod {
  SMS_OTP
  SIGNATURE
  NONE
}

model CollectionWeighIn {
  id             String             @id @default(cuid())
  clientUuid     String             @unique // idempotent offline sync
  tripId         String
  vendorId       String
  materialTypeId String
  weightKg       Decimal            @db.Decimal(10, 2)
  ratePerKg      Decimal            @db.Decimal(12, 2) // snapshot from rate card
  amount         Decimal            @db.Decimal(14, 2)
  photoUrl       String?
  lat            Float?
  lng            Float?
  confirmation   ConfirmationMethod @default(NONE)
  signatureUrl   String?
  agentId        String?
  createdAt      DateTime           @default(now())

  trip         Trip         @relation(fields: [tripId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  materialType MaterialType @relation(fields: [materialTypeId], references: [id])

  @@index([tripId])
  @@index([vendorId])
}

model TripReconciliation {
  id         String   @id @default(cuid())
  tripId     String   @unique
  approvedBy String?
  approvedAt DateTime?
  note       String?
  createdAt  DateTime @default(now())

  trip  Trip                     @relation(fields: [tripId], references: [id])
  items TripReconciliationItem[]
}

model TripReconciliationItem {
  id                 String  @id @default(cuid())
  reconciliationId   String
  materialTypeId     String
  collectedKg        Decimal @db.Decimal(10, 2) // sum of field weigh-ins
  remittedKg         Decimal @db.Decimal(10, 2) // scaled at factory
  variancePct        Decimal @db.Decimal(6, 2)
  toleranceSnapshot  Decimal @db.Decimal(6, 2)
  varianceReason     String?

  reconciliation TripReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  materialType   MaterialType       @relation(fields: [materialTypeId], references: [id])
}

enum PayoutBatchStatus {
  AWAITING_FUNDS
  READY
  PROCESSING
  COMPLETED
  PARTIAL_FAILED
}

model PayoutBatch {
  id          String            @id @default(cuid())
  tripId      String            @unique
  totalAmount Decimal           @db.Decimal(14, 2)
  status      PayoutBatchStatus @default(READY)
  releasedBy  String?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())

  trip    Trip     @relation(fields: [tripId], references: [id])
  payouts Payout[]
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model Payout {
  id             String       @id @default(cuid())
  batchId        String
  vendorId       String
  amount         Decimal      @db.Decimal(14, 2)
  idempotencyKey String       @unique
  paystackRef    String?
  status         PayoutStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  batch  PayoutBatch @relation(fields: [batchId], references: [id])
  vendor Vendor      @relation(fields: [vendorId], references: [id])

  @@index([status])
}

// ───────────────────────────── Purchasing ─────────────────────────────

model SupplierType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  suppliers Supplier[]
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  typeId          String?
  phone           String?
  contactPerson   String?
  contactPhone    String?
  address         String?
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  notes           String?
  createdAt       DateTime @default(now())

  type            SupplierType?     @relation(fields: [typeId], references: [id])
  purchaseBatches PurchaseBatch[]
  payments        SupplierPayment[]
}

model PurchaseBatch {
  id                  String                @id @default(cuid())
  siteId              String
  supplierId          String
  lotNo               String                @unique
  purchasedById       String? // purchasing manager user id
  fieldEstKg          Decimal?              @db.Decimal(10, 2)
  scaledInAt          DateTime?
  scaledInById        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  site             Site                @relation(fields: [siteId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseBatchItem[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]

  @@index([siteId, createdAt])
}

model PurchaseBatchItem {
  id             String  @id @default(cuid())
  batchId        String
  materialTypeId String
  weightKg       Decimal @db.Decimal(10, 2)
  pricePerKg     Decimal @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(14, 2)
  photoUrl       String?

  batch        PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialType MaterialType  @relation(fields: [materialTypeId], references: [id])
}

enum PaymentMethod {
  TRANSFER
  CASH
  PAYSTACK
}

// A single supplier account: every payment (advance or against a batch,
// from any screen) is a credit here. Delivered batches are the debits.
// Balance = Σ payments − Σ delivered value; batches settle FIFO.
model SupplierPayment {
  id         String        @id @default(cuid())
  supplierId String
  batchId    String? // optional: the batch this payment was made in relation to
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod @default(TRANSFER)
  reference  String?
  note       String?
  paidById   String?
  paidAt     DateTime      @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  batch    PurchaseBatch? @relation(fields: [batchId], references: [id])

  @@index([supplierId])
}

// ─────────────────── Materials, Inventory & Production ───────────────────

enum MaterialKind {
  RAW // purchased / collected (pre-processing)
  INTERMEDIATE // produced by a stage, consumed by another (in processing)
  FINISHED // produced by an end-of-line stage, sellable
}

// The universal material catalog: raw stock, intermediate sub-streams, and
// finished goods are all materials, distinguished by `kind`.
model MaterialType {
  id     String       @id @default(cuid())
  name     String       @unique
  kind     MaterialKind @default(RAW)
  color    String?
  active   Boolean      @default(true)
  sellable Boolean      @default(false) // FINISHED goods are always sellable; flag lets an intermediate be sold too

  weighIns            CollectionWeighIn[]
  purchaseItems       PurchaseBatchItem[]
  reconciliationItems TripReconciliationItem[]
  jobs                Job[] // as a job's INPUT material
  jobOutputs          JobOutput[] // as a job's OUTPUT material
  movements           InventoryMovement[]
  rateCards           RateCard[]
  vendorRates         VendorRate[]
  targets             Target[]
  recipesAsInput      StageOutput[]           @relation("RecipeInput")
  recipesAsOutput     StageOutput[]           @relation("RecipeOutput")
  priceLists          PriceList[]
  saleItems           SalesOrderItem[]
}

enum PayBasis {
  SCALE_IN // staff paid on weight assigned in (e.g. sorters)
  SCALE_OUT // staff paid on good output (e.g. crushers, pelletizers)
}

model ProcessStage {
  id       String   @id @default(cuid())
  name     String   @unique
  active   Boolean  @default(true)
  payBasis PayBasis @default(SCALE_OUT)

  jobs      Job[]
  locations InventoryLocation[]
  rateCards RateCard[]
  recipes   StageOutput[]
}

// A recipe row: at `stage`, input material yields output material.
// A (stage, input) pair with several rows = several outputs (e.g. Sorting +
// General Plastics → PP White, PP Blue, HDPE, Masterbatch).
model StageOutput {
  id                   String  @id @default(cuid())
  stageId              String
  inputMaterialTypeId  String
  outputMaterialTypeId String
  active               Boolean @default(true)

  stage          ProcessStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  inputMaterial  MaterialType @relation("RecipeInput", fields: [inputMaterialTypeId], references: [id])
  outputMaterial MaterialType @relation("RecipeOutput", fields: [outputMaterialTypeId], references: [id])

  @@unique([stageId, inputMaterialTypeId, outputMaterialTypeId])
  @@index([stageId, inputMaterialTypeId])
}

enum LocationKind {
  INTAKE // raw materials (pre-processing)
  IN_PROCESSING // intermediate materials produced, awaiting the next stage
  STAGE_WIP // material actively being worked in a job at a stage
  FINISHED_STORE
  VEHICLE
  CUSTOMER // terminal location for sales
  VENDOR_GATE // origin location for collections
  WASTE // terminal location for scaled-out waste
}

model InventoryLocation {
  id      String       @id @default(cuid())
  siteId  String
  kind    LocationKind
  stageId String?
  name    String

  site  Site          @relation(fields: [siteId], references: [id])
  stage ProcessStage? @relation(fields: [stageId], references: [id])

  movementsFrom InventoryMovement[] @relation("MoveFrom")
  movementsTo   InventoryMovement[] @relation("MoveTo")

  @@unique([siteId, kind, stageId, name])
}

enum MovementRefType {
  TRIP
  PURCHASE_BATCH
  JOB
  SALE
  TRANSFER
  ADJUSTMENT
}

// Append-only. Corrections are reversing entries. Every material (raw,
// intermediate, finished) is keyed by materialTypeId.
model InventoryMovement {
  id             String          @id @default(cuid())
  fromLocationId String?
  toLocationId   String?
  materialTypeId String?
  weightKg       Decimal         @db.Decimal(10, 2)
  lotNo          String?
  refType        MovementRefType
  refId          String
  byId           String?
  note           String?
  createdAt      DateTime        @default(now())

  fromLocation InventoryLocation? @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocation   InventoryLocation? @relation("MoveTo", fields: [toLocationId], references: [id])
  materialType MaterialType?      @relation(fields: [materialTypeId], references: [id])

  @@index([refType, refId])
  @@index([lotNo])
  @@index([toLocationId, createdAt])
  @@index([fromLocationId, createdAt])
}

enum JobStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FLAGGED // discrepancy beyond tolerance, awaiting supervisor resolution
  RESOLVED
}

model Job {
  id                String    @id @default(cuid())
  siteId            String
  stageId           String
  materialTypeId    String
  lotNo             String?
  weightInKg        Decimal   @db.Decimal(10, 2)
  weightOutKg       Decimal?  @db.Decimal(10, 2)
  wasteKg           Decimal?  @db.Decimal(10, 2)
  toleranceSnapshot Decimal   @db.Decimal(6, 2)
  scaleInPhotoUrl   String?
  scaleOutPhotoUrl  String?
  status            JobStatus @default(ASSIGNED)
  flagReason        String?
  resolvedById      String?
  payrollRunId      String? // set when the job's wages are locked into a payroll run
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  site         Site            @relation(fields: [siteId], references: [id])
  stage        ProcessStage    @relation(fields: [stageId], references: [id])
  materialType MaterialType    @relation(fields: [materialTypeId], references: [id])
  assignments  JobAssignment[]
  outputs      JobOutput[]
  discrepancyCharges DiscrepancyCharge[]
  payrollRun   PayrollRun?     @relation(fields: [payrollRunId], references: [id])

  @@index([siteId, status])
  @@index([lotNo])
}

// A scaled-out output line for a job: how much of each output material was
// produced. Sum of a job's outputs + waste + discrepancy = weightIn.
model JobOutput {
  id                   String  @id @default(cuid())
  jobId                String
  outputMaterialTypeId String
  weightKg             Decimal @db.Decimal(10, 2)

  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outputMaterial MaterialType @relation(fields: [outputMaterialTypeId], references: [id])

  @@index([jobId])
}

model JobAssignment {
  id      String @id @default(cuid())
  jobId   String
  staffId String
  share   Decimal @default(1) @db.Decimal(6, 4) // fraction of the job's wage (1.0 = sole worker)

  job   Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staff StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([jobId, staffId])
}

// A flagged discrepancy resolved by charging a staff member (or supervisor).
// Settled against a payroll item when the next payroll run is opened.
model DiscrepancyCharge {
  id            String   @id @default(cuid())
  jobId         String
  staffId       String
  amount        Decimal  @db.Decimal(14, 2)
  reason        String?
  payrollItemId String?
  createdAt     DateTime @default(now())

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id])

  @@index([staffId, payrollItemId])
}

// ───────────────────────────── HR & Wages ─────────────────────────────

// Piece rate paid to production staff per good-output kg.
model RateCard {
  id             String   @id @default(cuid())
  siteId         String? // null = global default
  stageId        String
  materialTypeId String
  ratePerKg      Decimal  @db.Decimal(12, 2)
  effectiveFrom  DateTime @default(now())

  site         Site?        @relation(fields: [siteId], references: [id])
  stage        ProcessStage @relation(fields: [stageId], references: [id])
  materialType MaterialType @relation(fields: [materialTypeId], references: [id])

  @@index([stageId, materialTypeId, effectiveFrom])
}

// Price paid to vendors per kg at collection.
model VendorRate {
  id             String   @id @default(cuid())
  materialTypeId String
  pricePerKg     Decimal  @db.Decimal(12, 2)
  effectiveFrom  DateTime @default(now())

  materialType MaterialType @relation(fields: [materialTypeId], references: [id])

  @@index([materialTypeId, effectiveFrom])
}

enum PayrollStatus {
  OPEN
  CLOSED
  PAID
}

model PayrollRun {
  id        String        @id @default(cuid())
  siteId    String
  weekStart DateTime
  weekEnd   DateTime
  status    PayrollStatus @default(OPEN)
  closedBy  String?
  createdAt DateTime      @default(now())

  site  Site          @relation(fields: [siteId], references: [id])
  items PayrollItem[]
  jobs  Job[]

  @@unique([siteId, weekStart])
}

model PayrollItem {
  id                   String  @id @default(cuid())
  runId                String
  staffId              String
  commissionAmount     Decimal @default(0) @db.Decimal(14, 2)
  baseAmount           Decimal @default(0) @db.Decimal(14, 2)
  earnedAmount         Decimal @db.Decimal(14, 2) // commission + base
  advanceDeduction     Decimal @default(0) @db.Decimal(14, 2)
  discrepancyDeduction Decimal @default(0) @db.Decimal(14, 2) // theft/loss charged back
  netAmount            Decimal @db.Decimal(14, 2)
  paymentRef           String?
  paidAt               DateTime?

  run   PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  staff StaffProfile @relation(fields: [staffId], references: [id])
  discrepancyCharges DiscrepancyCharge[]

  @@unique([runId, staffId])
}

model SalaryAdvance {
  id                 String   @id @default(cuid())
  staffId            String
  amount             Decimal  @db.Decimal(14, 2)
  repaidAmount       Decimal  @default(0) @db.Decimal(14, 2)
  weeklyDeductionCap Decimal? @db.Decimal(14, 2)
  note               String?
  grantedById        String?
  createdAt          DateTime @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id])
}

model Issuance {
  id        String   @id @default(cuid())
  staffId   String
  item      String // e.g. "Safety boots"
  quantity  Int      @default(1)
  condition String? // new | used
  signatureUrl String?
  issuedById String?
  issuedAt  DateTime @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id])
}

enum StaffLogKind {
  MEDICAL
  REWARD
  DISCIPLINARY
}

model StaffLog {
  id          String       @id @default(cuid())
  staffId     String
  kind        StaffLogKind
  description String
  cost        Decimal?     @db.Decimal(14, 2)
  loggedById  String?
  createdAt   DateTime     @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id])
}

// ─────────────────────────────── Sales ───────────────────────────────

model Customer {
  id              String   @id @default(cuid())
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  creditTermsDays Int      @default(0) // 0 = payment on dispatch
  notes           String?
  createdAt       DateTime @default(now())

  priceLists PriceList[]
  orders     SalesOrder[]
}

model PriceList {
  id             String   @id @default(cuid())
  materialTypeId String // a FINISHED material
  customerId     String? // null = list price; set = customer override
  pricePerKg     Decimal  @db.Decimal(12, 2)
  effectiveFrom  DateTime @default(now())

  materialType MaterialType @relation(fields: [materialTypeId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@index([materialTypeId, effectiveFrom])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CLOSED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  siteId      String
  customerId  String
  orderNo     String           @unique
  status      SalesOrderStatus @default(DRAFT)
  driverName  String?
  truckNo     String?
  waybillNo   String?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  site     Site             @relation(fields: [siteId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]
  invoice  Invoice?
  expenses Expense[]

  @@index([siteId, status])
}

model SalesOrderItem {
  id             String  @id @default(cuid())
  orderId        String
  materialTypeId String? // a FINISHED material (null for non-inventory lines)
  description    String? // used for non-inventory lines
  isInventory    Boolean @default(true)
  qtyKg          Decimal @db.Decimal(10, 2)
  unitPrice      Decimal @db.Decimal(12, 2) // custom per sale (defaults from price list)

  order        SalesOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialType MaterialType? @relation(fields: [materialTypeId], references: [id])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model Invoice {
  id           String        @id @default(cuid())
  salesOrderId String        @unique
  invoiceNo    String        @unique
  amount       Decimal       @db.Decimal(14, 2)
  dueDate      DateTime
  status       InvoiceStatus @default(UNPAID)
  createdAt    DateTime      @default(now())

  salesOrder SalesOrder        @relation(fields: [salesOrderId], references: [id])
  payments   CustomerPayment[]
}

model CustomerPayment {
  id         String        @id @default(cuid())
  invoiceId  String
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod @default(TRANSFER)
  reference  String?
  receivedById String?
  paidAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ────────────────────────── Finance & Planning ──────────────────────────

model ExpenseCategory {
  id   String @id @default(cuid())
  name String @unique

  expenses Expense[]
  budgets  Budget[]
}

model Expense {
  id              String   @id @default(cuid())
  siteId          String
  categoryId      String
  amount          Decimal  @db.Decimal(14, 2)
  description     String?
  receiptUrl      String?
  purchaseBatchId String?
  tripId          String?
  salesOrderId    String?
  incurredAt      DateTime @default(now())
  recordedById    String?
  createdAt       DateTime @default(now())

  site          Site            @relation(fields: [siteId], references: [id])
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  purchaseBatch PurchaseBatch?  @relation(fields: [purchaseBatchId], references: [id])
  trip          Trip?           @relation(fields: [tripId], references: [id])
  salesOrder    SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  cashTx        CashTransaction?

  @@index([siteId, incurredAt])
}

enum WalletTxKind {
  TOPUP
  PAYOUT
  FEE
  REFUND
}

// Mirror of the Paystack balance — append-only.
model WalletTransaction {
  id          String       @id @default(cuid())
  kind        WalletTxKind
  amount      Decimal      @db.Decimal(14, 2) // positive = in, negative = out
  paystackRef String?
  note        String?
  createdAt   DateTime     @default(now())
}

// Daily diesel consumption — reported against finished output (litres/kg)
// to surface diesel theft or inefficiency over time.
enum DieselLogKind {
  PURCHASE
  USAGE
}

model DieselLog {
  id           String        @id @default(cuid())
  siteId       String
  kind         DieselLogKind @default(PURCHASE)
  date         DateTime
  litres       Decimal       @db.Decimal(10, 2) // litres bought (PURCHASE) or consumed (USAGE)
  cost         Decimal?      @db.Decimal(14, 2) // total cost of a purchase
  note         String? // supplier / equipment / purpose
  recordedById String?
  createdAt    DateTime      @default(now())

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, date])
}

enum CashTxKind {
  FUNDING // money moved into the account (float top-up)
  EXPENSE // money spent by the manager (also recorded as an Expense)
  ADJUSTMENT
}

/**
 * A spendable cash/float account (e.g. "Factory expenses"). Funded from company
 * money; the manager records spend against it. Balance = sum of transactions —
 * never stored. Spend rows also create a categorised Expense so P&L stays correct.
 */
model CashAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  siteId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  site         Site?             @relation(fields: [siteId], references: [id])
  transactions CashTransaction[]
}

model CashTransaction {
  id           String     @id @default(cuid())
  accountId    String
  kind         CashTxKind
  amount       Decimal    @db.Decimal(14, 2) // + into the account (funding), - out (spend)
  note         String?
  expenseId    String?    @unique // set when a spend created a linked Expense
  recordedById String?
  createdAt    DateTime   @default(now())

  account CashAccount @relation(fields: [accountId], references: [id])
  expense Expense?    @relation(fields: [expenseId], references: [id])

  @@index([accountId, createdAt])
}

model Budget {
  id         String   @id @default(cuid())
  siteId     String? // null = company-wide
  categoryId String
  periodYear Int
  periodMonth Int // 1-12
  amount     Decimal  @db.Decimal(14, 2)

  site     Site?           @relation(fields: [siteId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([siteId, categoryId, periodYear, periodMonth])
}

enum TargetMetric {
  FINISHED_OUTPUT_KG
  COLLECTION_KG
  PURCHASE_KG
  SALES_NAIRA
}

model Target {
  id             String       @id @default(cuid())
  siteId         String? // null = company-wide
  materialTypeId String? // null = all materials
  metric         TargetMetric
  periodYear     Int
  periodMonth    Int
  value          Decimal      @db.Decimal(14, 2)

  site         Site?         @relation(fields: [siteId], references: [id])
  materialType MaterialType? @relation(fields: [materialTypeId], references: [id])

  @@unique([siteId, materialTypeId, metric, periodYear, periodMonth])
}
